    "add-swimsuits": "node scripts/addSwimsuits.mjs",
    "add-summer2026": "node scripts/addSummer2026.mjs",
    "import-excel": "node scripts/syncStar5FromExcel.mjs",
    "sync-star5": "node scripts/syncStar5FromExcel.mjs",
    "tag-events": "node scripts/tagEvents.mjs",
    "download-portraits": "node scripts/downloadPortraits.mjs",
    "download-cards": "node scripts/downloadCardArts.mjs",
    "download-gamerch-cards": "node scripts/downloadGamerchCards.mjs",
    "fix-missing-cards": "node scripts/fixMissingCards.mjs",
    "merge-stats": "node scripts/mergeStats.mjs",
    "cut-portraits": "node scripts/cutPortraitBg.mjs",
    "fix-game-data": "node scripts/fixGameData.mjs",
    "precompute-pr": "npx tsx scripts/precomputePrBaselines.ts",
