{
  "name": "holodream-optimizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run predev && vite",
    "build": "npm run predev && tsc -b && vite build",
    "preview": "vite preview",
